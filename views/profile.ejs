<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="text-white bg-[radial-gradient(circle_at_top_left,_#2563eb,_transparent_25%),radial-gradient(circle_at_bottom_right,_#7c3aed,_transparent_25%),radial-gradient(circle_at_center,_#0f172a,_#000)] min-h-screen">
    <div class="max-w-5xl mx-auto min-h-screen px-6 py-10">

        <!-- Top Navbar -->
        <div class="flex items-center justify-between mb-10">

            <div>
                <h1 class="text-4xl font-bold tracking-tight">
                    👋 Hello, <span class="text-blue-400"><%= user.name %></span>
                </h1>

                <p class="text-zinc-400 mt-2 text-lg">
                    Share your thoughts with the world.
                </p>
            </div>

            <a 
                href="/logout"
                class="bg-red-500 hover:bg-red-600 transition-all duration-300 px-5 py-2 rounded-xl text-sm font-medium shadow-lg shadow-red-500/20"
            >
                Logout
            </a>

        </div>

        <!-- Create Post Card -->
        <div class="bg-zinc-900/70 backdrop-blur-md border border-zinc-800 rounded-3xl p-6 shadow-2xl">

            <h2 class="text-2xl font-semibold mb-5">
                ✨ Create a New Post
            </h2>

            <form action="/post" method="post">

                <textarea 
                    name="content"
                    placeholder="What's on your mind today?"
                    class="w-full h-36 p-4 rounded-2xl bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none resize-none transition-all duration-300 text-zinc-200"
                ></textarea>

                <div class="flex justify-end mt-4">

                    <input 
                        type="submit"
                        value="Create Post"
                        class="bg-blue-500 hover:bg-blue-600 transition-all duration-300 px-6 py-3 rounded-xl cursor-pointer font-medium shadow-lg shadow-blue-500/20"
                    >

                </div>

            </form>

        </div>

        <!-- Posts Section -->
        <div class="mt-14">

            <div class="flex items-center justify-between mb-8">

                <h2 class="text-3xl font-bold">
                    📝 Your Posts
                </h2>

                <span class="text-zinc-400 text-sm">
                    <%= user.post.length %> Posts
                </span>

            </div>

            <!-- Posts Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

                <% user.post.reverse().forEach(function(post){ %>

                    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5 hover:border-blue-500/50 hover:-translate-y-1 transition-all duration-300 shadow-xl">

                        <!-- Username -->
                        <div class="flex items-center gap-3 mb-4">

                            <div class="w-12 h-12 rounded-full bg-blue-500 flex items-center justify-center text-lg font-bold">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>

                            <div>
                                <h4 class="text-blue-400 font-semibold">
                                    @<%= user.username %>
                                </h4>

                                <p class="text-xs text-zinc-500">
                                    Just now
                                </p>
                            </div>

                        </div>

                        <!-- Post Content -->
                        <p class="text-zinc-300 leading-relaxed break-words">
                            <%= post.content %>
                        </p>

                        <!-- Footer -->
                        <div class="flex items-center justify-between mt-6">

                            <small class="text-zinc-500">
                                ❤️ <%= post.likes.length %> likes
                            </small>

                            <div class="flex items-center gap-4 text-sm">

                                <a 
                                    class="text-blue-400 hover:text-blue-300 transition"
                                    href="/like/<%= post._id %>"
                                >
                                    <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                                </a>

                                <a 
                                    class="text-zinc-400 hover:text-white transition"
                                    href="/edit/<%= post._id %>"
                                >
                                    Edit
                                </a>

                                <a 
                                 class="text-red-400 hover:text-red-300 transition-all duration-300 font-medium"
                                  href="/delete/<%= post._id %>"
                                >
                                 🗑️ Delete
                                 </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </div>

</body>
</html>