<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="text-white bg-[radial-gradient(circle_at_top_left,_#2563eb,_transparent_25%),radial-gradient(circle_at_bottom_right,_#7c3aed,_transparent_25%),radial-gradient(circle_at_center,_#0f172a,_#000)] min-h-screen">
    <div class="w-full min-h-screen flex items-center justify-center px-6">

        <!-- Card -->
        <div class="w-full max-w-md bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 shadow-2xl">

            <!-- Heading -->
            <div class="text-center mb-8">

                <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-r from-blue-500 to-cyan-500 flex items-center justify-center text-3xl font-bold shadow-lg shadow-blue-500/20">
                    🚀
                </div>

                <h1 class="text-4xl font-bold mt-5">
                    Create Account
                </h1>

                <p class="text-zinc-400 mt-2">
                    Join the community and start sharing your thoughts.
                </p>

            </div>

            <!-- Form -->
            <form action="/register" method="post" class="flex flex-col gap-4">

                <!-- Username -->
                <div>
                    <label class="text-sm text-zinc-400 mb-2 inline-block">
                        Username
                    </label>

                    <input 
                        class="w-full px-4 py-3 rounded-2xl outline-none bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                        type="text"
                        placeholder="Enter username"
                        name="username"
                    >
                </div>

                <!-- Name -->
                <div>
                    <label class="text-sm text-zinc-400 mb-2 inline-block">
                        Full Name
                    </label>

                    <input 
                        class="w-full px-4 py-3 rounded-2xl outline-none bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                        type="text"
                        placeholder="Enter your name"
                        name="name"
                    >
                </div>

                <!-- Age -->
                <div>
                    <label class="text-sm text-zinc-400 mb-2 inline-block">
                        Age
                    </label>

                    <input 
                        class="w-full px-4 py-3 rounded-2xl outline-none bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                        type="number"
                        placeholder="Enter your age"
                        name="age"
                    >
                </div>

                <!-- Email -->
                <div>
                    <label class="text-sm text-zinc-400 mb-2 inline-block">
                        Email Address
                    </label>

                    <input 
                        class="w-full px-4 py-3 rounded-2xl outline-none bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                        type="email"
                        placeholder="Enter your email"
                        name="email"
                    >
                </div>

                <!-- Password -->
                <div>
                    <label class="text-sm text-zinc-400 mb-2 inline-block">
                        Password
                    </label>

                    <input 
                        class="w-full px-4 py-3 rounded-2xl outline-none bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                        type="password"
                        placeholder="Create password"
                        name="password"
                    >
                </div>

                <!-- Submit -->
                <input 
                    class="w-full mt-3 py-3 bg-blue-500 hover:bg-blue-600 transition-all duration-300 rounded-2xl cursor-pointer font-semibold shadow-lg shadow-blue-500/20"
                    type="submit"
                    value="Create Account"
                >

            </form>

            <!-- Footer -->
            <p class="text-center text-zinc-500 text-sm mt-6">
                Already have an account?
                <a href="/login" class="text-blue-400 hover:text-blue-300">
                    Login
                </a>
            </p>

        </div>

    </div>

</body>
</html>