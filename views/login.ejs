<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - SnapThoughts</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-[radial-gradient(circle_at_top_left,_#2563eb,_transparent_25%),radial-gradient(circle_at_bottom_right,_#7c3aed,_transparent_25%),radial-gradient(circle_at_center,_#0f172a,_#000)] text-white px-6">

    <div class="w-full max-w-md bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 shadow-2xl">

        <!-- Heading -->
        <div class="text-center mb-8">

            <h1 class="text-4xl font-bold tracking-tight">
                👋 Welcome Back,
                <span class="text-blue-400">
                    User
                </span>
            </h1>

            <p class="text-zinc-400 mt-3">
                Login to continue sharing your thoughts.
            </p>

        </div>

        <!-- Login Form -->
        <form action="/login" method="post" class="space-y-5">

            <!-- Email -->
            <div>

                <label class="block mb-2 text-sm text-zinc-300">
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                    class="w-full px-5 py-3 rounded-2xl bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none transition-all duration-300 text-zinc-200"
                >

            </div>

            <!-- Password -->
            <div>

                <label class="block mb-2 text-sm text-zinc-300">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="Enter your password"
                    required
                    class="w-full px-5 py-3 rounded-2xl bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none transition-all duration-300 text-zinc-200"
                >

            </div>

            <!-- Button -->
            <button
                type="submit"
                class="w-full bg-blue-500 hover:bg-blue-600 transition-all duration-300 py-3 rounded-2xl font-semibold shadow-lg shadow-blue-500/20 cursor-pointer"
            >
                Login
            </button>

        </form>

        <!-- Register -->
        <p class="text-center text-zinc-400 mt-6">

            Don't have an account?

            <a
                href="/"
                class="text-blue-400 hover:text-blue-300 font-medium"
            >
                Register
            </a>

        </p>

    </div>

</body>
</html>