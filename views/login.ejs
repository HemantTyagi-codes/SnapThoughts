<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="text-white bg-[radial-gradient(circle_at_top_left,_#2563eb,_transparent_25%),radial-gradient(circle_at_bottom_right,_#7c3aed,_transparent_25%),radial-gradient(circle_at_center,_#0f172a,_#000)] min-h-screen">
    <div class="max-w-6xl mx-auto min-h-screen px-6 py-10">

        <!-- Navbar -->
        <div class="flex items-center justify-between mb-12">

            <div>
                <h1 class="text-4xl font-bold tracking-tight">
                    👋 Welcome Back,
                    <span class="text-blue-400">
                        <%= user.name %>
                    </span>
                </h1>

                <p class="text-zinc-400 mt-2">
                    Share your ideas, thoughts and moments.
                </p>
            </div>

            <a 
                href="/logout"
                class="bg-red-500 hover:bg-red-600 transition-all duration-300 px-5 py-3 rounded-2xl text-sm font-semibold shadow-lg shadow-red-500/20"
            >
                Logout
            </a>

        </div>

        <!-- Create Post Section -->
        <div class="bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-7 shadow-2xl">

            <div class="flex items-center gap-3 mb-5">

                <div class="w-14 h-14 rounded-full bg-blue-500 flex items-center justify-center text-xl font-bold">
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>

                <div>
                    <h2 class="text-xl font-semibold">
                        Create New Post
                    </h2>

                    <p class="text-zinc-400 text-sm">
                        Express what’s on your mind.
                    </p>
                </div>

            </div>

            <form action="/post" method="post">

                <textarea 
                    name="content"
                    placeholder="What's on your mind today?"
                    class="w-full h-36 p-5 rounded-2xl bg-zinc-950 border border-zinc-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none resize-none transition-all duration-300 text-zinc-200"
                ></textarea>

                <div class="flex justify-end mt-5">

                    <input 
                        type="submit"
                        value="Create Post"
                        class="bg-blue-500 hover:bg-blue-600 px-7 py-3 rounded-2xl font-medium cursor-pointer transition-all duration-300 shadow-lg shadow-blue-500/20"
                    >

                </div>

            </form>

        </div>

        <!-- Posts -->
        <div class="mt-16">

            <div class="flex items-center justify-between mb-8">

                <h2 class="text-3xl font-bold">
                    📝 Your Posts
                </h2>

                <div class="bg-zinc-800 px-4 py-2 rounded-full text-sm text-zinc-300">
                    Total Posts:
                    <span class="text-blue-400 font-semibold">
                        <%= user.post.length %>
                    </span>
                </div>

            </div>

            <!-- Posts Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <% user.post.reverse().forEach(function(post){ %>

                    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-6 hover:border-blue-500/40 hover:-translate-y-1 transition-all duration-300 shadow-xl">

                        <!-- Header -->
                        <div class="flex items-center justify-between mb-5">

                            <div class="flex items-center gap-3">

                                <div class="w-12 h-12 rounded-full bg-gradient-to-r from-blue-500 to-cyan-500 flex items-center justify-center font-bold">
                                    <%= user.name.charAt(0).toUpperCase() %>
                                </div>

                                <div>
                                    <h4 class="text-blue-400 font-semibold">
                                        @<%= user.username %>
                                    </h4>

                                    <p class="text-xs text-zinc-500">
                                        Posted recently
                                    </p>
                                </div>

                            </div>

                        </div>

                        <!-- Content -->
                        <p class="text-zinc-300 leading-relaxed break-words min-h-[90px]">
                            <%= post.content %>
                        </p>

                        <!-- Footer -->
                        <div class="flex items-center justify-between mt-6 pt-4 border-t border-zinc-800">

                            <small class="text-zinc-500">
                                ❤️ <%= post.likes.length %> likes
                            </small>

                            <div class="flex items-center gap-5">

                                <a 
                                    class="text-blue-400 hover:text-blue-300 transition-all duration-300 font-medium"
                                    href="/like/<%= post._id %>"
                                >
                                    <%= post.likes.indexOf(user._id) === -1 ? "Like 👍" : "Unlike 💔" %>
                                </a>

                                <a 
                                    class="text-zinc-400 hover:text-white transition-all duration-300 font-medium"
                                    href="/edit/<%= post._id %>"
                                >
                                    ✏️ Edit
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </div>

</body>
</html>